# ── API Keys (required) ─────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-xxx
# OPENROUTER_API_KEY=sk-xxx       # for distill pipeline

# ── MLflow (optional) ───────────────────────────────────────────────
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=dspytools

# ── Directory Overrides (optional — see defaults in config/settings.py)
# DSPYTOOLS_CONFIG_DIR=~/.config/dspytools
# DSPYTOOLS_DATA_DIR=~/.local/share/dspytools
# DSPYTOOLS_CACHE_DIR=~/.cache/dspytools/analysis
# DSPYTOOLS_SKILLS_DIR=~/.config/dspytools/skills
# DSPYTOOLS_ADAPTERS_DIR=~/.config/dspytools/adapters

# ── Project Path Overrides (optional) ───────────────────────────────
# DSPYTOOLS_PROJECT_DIR=
# DSPYTOOLS_COMPILED_DIR=<project>/compiled
# DSPYTOOLS_MODULES_DIR=<project>/modules
# DSPYTOOLS_SIGNATURES_DIR=<project>/signatures
# DSPYTOOLS_AGENTS_DIR=<project>/agents
# DSPYTOOLS_DISTILL_DIR=<project>/output

# ── vLLM Server URLs (optional) ─────────────────────────────────────
# DSPYTOOLS_LLM_URL=http://127.0.0.1:8000
# DSPYTOOLS_EMBEDDING_URL=http://127.0.0.1:8001
# DSPYTOOLS_LORA_URL=http://127.0.0.1:9000
# DSPYTOOLS_EMBEDDING_MODEL=embeddinggemma

# ── Persistent State File Paths (optional) ──────────────────────────
# DSPYTOOLS_HELP_CACHE=~/.config/dspytools/help_compiled.json
# DSPYTOOLS_HELP_META=~/.config/dspytools/help_meta.json
# DSPYTOOLS_DRIFT_STATE=~/.config/dspytools/drift_state.json
# DSPYTOOLS_LSE_LOG=~/.config/dspytools/lse_log.json
# DSPYTOOLS_GRAO_LOG=~/.config/dspytools/grao_log.json
# DSPYTOOLS_META_OPTIMIZER=~/.config/dspytools/meta_optimizer.json
# DSPYTOOLS_QUALITY_LOG=~/.config/dspytools/quality_log.json
# DSPYTOOLS_TRAJECTORIES_DB=~/.config/dspytools/trajectories.db
# DSPYTOOLS_MORPHOLOGY=~/.config/dspytools/morphology.json
# DSPYTOOLS_SKILL_GRAPH=~/.config/dspytools/skill_graph.json

# ── dspy-lora Distillation (optional) ───────────────────────────────
# DSPY_LORA_DIR=/home/octagono/dspy-lora
